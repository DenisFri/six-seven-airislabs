  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit(docs/**)",
      "Edit(.claude/**)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform plan:*)",
      "Bash(terraform output:*)",
      "Bash(terraform show:*)",
      "Bash(terraform state list:*)",
      "Bash(terraform state show:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add docs:*)",
      "Bash(git commit:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(helm list:*)",
      "Bash(helm status:*)",
      "Bash(gcloud config list:*)",
      "Bash(gcloud compute instances list:*)",
      "Bash(gcloud compute instances describe:*)",
      "Bash(gcloud compute firewall-rules list:*)",
      "Bash(gcloud compute networks list:*)",
      "Bash(gcloud compute networks subnets list:*)",
      "Bash(gcloud compute routers list:*)",
      "Bash(gcloud compute routers nats list:*)",
      "Bash(gcloud compute addresses list:*)",
      "Bash(cp docs/build-log.md:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(file:*)"
    ],
    "ask": [
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(git push:*)",
      "Bash(kubectl apply:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(gcloud:*)"
    ],
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform state rm:*)",
      "Bash(kubectl delete:*)",
      "Bash(helm uninstall:*)",
      "Bash(gcloud compute instances delete:*)",
      "Bash(gcloud compute networks delete:*)",
      "Bash(gcloud compute firewall-rules delete:*)",
      "Bash(gcloud compute routers delete:*)",
      "Bash(gcloud projects delete:*)",
      "Bash(rm -rf:*)",
      "Read(./terraform/*.tfstate*)",
      "Read(./terraform/.terraform/**)",
      "Read(./**/kubeconfig*)",
      "Read(~/.ssh/airis)",
      "Edit(./terraform/*.tfstate*)"
    ]
  }
}
